# Sao chép file này thành .env.local và điền API key thật
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Model Gemini dùng cho app (free tier). Có thể đổi mà không cần sửa code:
# gemini-2.5-flash (khuyên dùng — gemini-2.0-flash bị giới hạn free tier = 0 với nhiều key mới)
GEMINI_MODEL=gemini-2.5-flash

# Model nhẹ hơn cho các lượt dịch từ đơn giản (module tra từ trong Chat) — có
# quota/ngày riêng biệt với GEMINI_MODEL vì free tier giới hạn theo từng model.
GEMINI_MODEL_LITE=gemini-2.5-flash-lite

# Supabase Auth — lấy ở Project Settings > API (anon/public key, an toàn để lộ ở client)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# Supabase Postgres — lấy ở Project Settings > Database > Connection string
# DATABASE_URL: dùng "Connection pooling" (port 6543, có ?pgbouncer=true) — dùng lúc app chạy
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: dùng "Direct connection" (port 5432) — chỉ dùng khi chạy `prisma migrate`
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Tính năng Nghe-Viết (Dictation) dùng Groq Whisper để transcribe audio kèm mốc
# thời gian TỪNG TỪ — nhờ vậy cắt câu bám đúng từ, không nuốt đầu/cuối câu.
# Lấy key MIỄN PHÍ tại: https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Model nhận dạng giọng nói. whisper-large-v3 chính xác nhất (WER 10.3%);
# đổi sang whisper-large-v3-turbo nếu muốn nhanh/rẻ hơn (WER 12%).
GROQ_STT_MODEL=whisper-large-v3
