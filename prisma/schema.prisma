// Prisma + Supabase (Postgres). DATABASE_URL = connection pooling (port 6543,
// dùng lúc runtime/serverless); DIRECT_URL = kết nối trực tiếp (port 5432,
// chỉ dùng khi chạy migrate).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Hồ sơ người học — 1 dòng / user (userId = id của user trong Supabase Auth).
// Lưu trình độ CEFR tổng và theo từng kỹ năng để Dashboard vẽ tiến độ.
model Profile {
  userId        String    @id
  overallLevel  String    @default("A2")
  listening     String?
  reading       String?
  writing       String?
  speaking      String?
  placementDone Boolean   @default(false)
  streak        Int       @default(0)
  dailyGoal     Int       @default(3) // số "hoạt động luyện tập" muốn hoàn thành mỗi ngày
  points        Int       @default(0) // điểm thưởng — đổi lấy đặc quyền chức năng (xem lib/points.ts)
  lastStudyDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Mỗi lần luyện tập / test = 1 Attempt. Nguồn dữ liệu cho mọi biểu đồ tiến độ.
// detail chứa JSON bằng chứng (lỗi cụ thể, chỉ số) do Assessor sinh ra.
model Attempt {
  id        Int      @id @default(autoincrement())
  userId    String
  skill     String // placement | chat | writing | speaking | reading | listening
  cefr      String // A1..C2
  score     Float // 1..6 (A1=1 ... C2=6)
  detail    String? // JSON: rationale, errors, metrics
  createdAt DateTime @default(now())

  @@index([userId, skill, createdAt])
}

// Thẻ từ vựng ôn theo thuật toán lặp lại ngắt quãng SM-2 (kiểu Anki).
// Được thêm tự động từ các bài Đọc; ôn ở màn "Ôn từ vựng".
model VocabCard {
  id            Int      @id @default(autoincrement())
  userId        String
  word          String
  meaning       String
  example       String?
  pronunciation String? // IPA, lấy kèm miễn phí từ cache dịch (TranslationCache) khi thêm từ
  level         String // cấp CEFR của từ khi được thêm vào
  sourceSkill   String // "reading" (mở rộng nguồn khác sau này nếu cần)
  repetition    Int      @default(0) // số lần ôn đúng liên tiếp (SM-2)
  easeFactor    Float    @default(2.5) // hệ số dễ/khó (SM-2)
  intervalDays  Int      @default(0)
  dueDate       DateTime @default(now()) // đến hạn ôn lại
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, word])
  @@index([userId, dueDate])
}

// 1 phiên chat = 1 cuộc hội thoại liên tục trên trang Chat. Tin nhắn lưu ở
// ChatMessage bên dưới, lưu real-time theo từng lượt (không đợi kết thúc phiên).
model ChatSession {
  id              Int       @id @default(autoincrement())
  userId          String
  level           String
  style           String    @default("chat") // "chat" | "casual-speaking"
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  analyzedAt      DateTime? // "Học theo câu" đã chạy chưa — chặn phân tích lại tốn phí Gemini
  suggestionsJson String? // cache kết quả phân tích (JSON) để mở lại không gọi lại Gemini

  @@index([userId, startedAt])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId Int
  userId    String // denormalized để query thẳng theo user, không cần join
  role      String // "user" | "model"
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// Câu gợi ý cải thiện từ tính năng "Học theo câu" (phân tích tin nhắn user gửi
// trong Chat) — chỉ tạo dòng khi user bấm "+ Thêm", không lưu mọi gợi ý AI đưa ra.
model LearningSentence {
  id           Int      @id @default(autoincrement())
  userId       String
  original     String // câu gốc user viết
  suggested    String // câu gợi ý tự nhiên/nâng cao hơn
  explanation  String // vì sao câu gợi ý tốt hơn
  level        String // cấp CEFR ước lượng của câu gợi ý
  status       String   @default("not_reviewed") // not_reviewed | reviewing | mastered
  sentenceHash String // sha256(normalizeContext(original)) — chống trùng
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, sentenceHash])
  @@index([userId, status])
}

// Cụm từ/thành ngữ thông dụng do AI sinh theo trình độ — ôn theo SM-2 y hệt
// VocabCard (dùng chung lib/srs.ts). repetition=0 = cụm mới chưa học lần nào,
// vào hàng đợi /api/phrases/due giống thẻ đã đến hạn ôn (xem app/(app)/phrases).
model PhraseCard {
  id           Int      @id @default(autoincrement())
  userId       String
  phrase       String // cụm từ tiếng Anh, vd "make up your mind"
  meaning      String // nghĩa tiếng Việt
  example      String // câu ví dụ có dùng cụm từ này
  blankWord    String // từ trong phrase bị ẩn đi để luyện điền từ
  level        String
  repetition   Int      @default(0)
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(0)
  dueDate      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, phrase])
  @@index([userId, dueDate])
}

// Mỗi dòng = 1 lỗi đã được AI gắn nhãn phân loại (xem lib/mistake-categories.ts),
// trích từ WritingError của Viết/Nói/Chat — nguồn dữ liệu cho tính năng "Điểm yếu"
// (lib/weakness.ts). Không phân tích lại Attempt cũ, chỉ ghi từ nay về sau.
model MistakeRecord {
  id          Int      @id @default(autoincrement())
  userId      String
  skill       String // "writing" | "speaking" | "chat"
  category    String // 1 giá trị trong MISTAKE_CATEGORIES
  original    String
  correction  String
  explanation String
  createdAt   DateTime @default(now())

  @@index([userId, category, createdAt])
}

// Cache dịch từ/cụm theo ngữ cảnh — GLOBAL (không theo userId): nghĩa của 1 từ
// trong 1 câu cụ thể không phụ thuộc ai hỏi, nên cache chung tối đa hoá tỉ lệ
// trùng giữa nhiều user. Không chứa PII nên an toàn khi không gắn userId.
// Xem lib/translation-cache.ts và lib/word-complexity.ts.
model TranslationCache {
  id            Int      @id @default(autoincrement())
  word          String // đã chuẩn hoá: lowercase, trim
  contextHash   String // sha256 hex của câu ngữ cảnh đã chuẩn hoá
  meaning       String
  example       String?
  pronunciation String?
  source        String // "dict" | "llm"
  createdAt     DateTime @default(now())

  @@unique([word, contextHash])
  @@index([word])
}

// Cache kết quả transcribe audio để không gọi Gemini 2 lần cho cùng 1 file.
// fileHash = sha256 hex của nội dung file — hash collision rất hiếm, chấp nhận
// được với quy mô cá nhân. durationSec lưu để track chi phí thực tế đã dùng.
model AudioTranscript {
  id          Int      @id @default(autoincrement())
  userId      String
  fileHash    String   // sha256 hex của raw bytes file audio
  transcript  String   // full text sau khi transcribe
  // JSON: [{ text, start, end }] — start/end tính bằng giây, dùng để phát lại
  // đúng đoạn audio gốc theo từng câu (thay vì đọc lại bằng TTS). Null = cache
  // cũ tạo trước khi có tính năng này — coi như cache miss, transcribe lại.
  segmentsJson String?
  durationSec Float    // độ dài audio tính bằng giây (user báo lên, best-effort)
  createdAt   DateTime @default(now())

  @@unique([userId, fileHash])
  @@index([userId])
}
